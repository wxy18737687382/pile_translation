# LLM API Configuration (Supports DeepSeek, OpenAI, Google Gemini, Qwen, Ollama, etc.)

# Option 1: DeepSeek (Recommended)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Option 2: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Google Gemini (OpenAI compatible endpoint)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Option 4: Local Ollama
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1

# =========================================================================
# Local UniMERNet Math Formula Recognition Service (Optional)
# =========================================================================
UNIMERNET_API_URL=http://127.0.0.1:8000/predict
